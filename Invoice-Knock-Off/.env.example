# ============================================================
# Zoho Payment Reconciliation - configuration
# Copy this file to ".env" and fill in your values.
# NEVER share or commit the .env file.
# ============================================================

# --- Zoho login (optional) ---------------------------------
# If left blank you simply log in by hand in the browser window.
ZOHO_EMAIL=
ZOHO_PASSWORD=

# --- Zoho Books address (required) -------------------------
# The address of YOUR Zoho Books data centre, e.g. one of:
#   https://books.zoho.com    (US)      https://books.zoho.eu  (EU)
#   https://books.zoho.in     (India)   https://books.zoho.com.au (AU)
# Tip: log in normally, then copy the start of the address bar.
ZOHO_BASE_URL=

# Organization name you expect to work in (optional).
# If set, you will be asked to confirm it in the browser before anything runs.
ZOHO_ORGANIZATION=

# --- Safety ----------------------------------------------------
# DRY_RUN=true  -> read and propose only. NOTHING is saved in Zoho.
# DRY_RUN=false -> approved applications are saved (approval still required).
DRY_RUN=true

# Stop after this many saved invoice applications in one run.
MAX_INVOICE_APPLICATIONS=50

# Maximum number of payments opened to look up "created by".
MAX_PAYMENTS_TO_REVIEW=25

# --- Business rules -------------------------------------------
# Only payments created by this person are considered.
# Several names can be separated by commas, e.g. Harish,Harish N
PAYMENT_CREATED_BY=Harish

# How amounts are read. "auto" (recommended) detects each amount: Zoho shows
# $1,234.56 and €1.234,56 side by side. Use "." or "," only to force one style.
AMOUNT_DECIMAL_SEPARATOR=auto

# --- Browser ------------------------------------------------------
HEADLESS=false
# "chrome" uses your installed Google Chrome; "chromium" uses Playwright's own browser.
BROWSER_CHANNEL=chrome
# Remember the Zoho login between runs (stored in data/browser-profile, never committed).
PERSIST_BROWSER_SESSION=true
# Seconds to wait for a Zoho page element before giving up.
ACTION_TIMEOUT_SECONDS=30

# --- Diagnostics --------------------------------------------------
LOG_LEVEL=INFO
SAVE_DEBUG_SCREENSHOTS=true
